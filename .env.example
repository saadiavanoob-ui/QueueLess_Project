# =============================================================================
# QueueLess Environment Variables Configuration
# =============================================================================

# Flask Secret Key (Generate a random string for production)
SECRET_KEY=replace_with_a_secure_random_string_for_production

# Flask Debug Mode (Set to False in production)
FLASK_DEBUG=False

# Persistent PostgreSQL Database URL (Neon / Supabase / Vercel Postgres / AWS RDS)
# Example Neon: postgresql://username:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres?sslmode=require
# If left blank, QueueLess will use local SQLite (queueless.db) or /tmp/queueless.db on Vercel
DATABASE_URL=

# Operator Portal Credentials (Optional override)
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=op123

# Administrator Console Credentials (Optional override)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
